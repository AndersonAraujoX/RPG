rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regras para a Campanha Kuar-Tor VTT (+2d6)
    
    // 1. Fichas de Personagens
    match /characters/{userId} {
      allow read, write: if true;
    }

    // 2. Salas de Campanha, Tokens, Combate e Grid Tático
    match /rooms/{roomId} {
      allow read, write: if true;

      // Subcoleção de Mensagens da Sala
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 3. Chat & Rolagens Globais
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Fallback permissivo para desenvolvimento e testes
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
